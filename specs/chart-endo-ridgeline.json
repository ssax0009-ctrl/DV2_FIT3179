  "transform": [
    {
      "density": "prevalence",
      "groupby": ["ageGroup", "sex"],
      "extent": [0, 22],
      "steps": 180,
      "bandwidth": 2,
      "as": ["prevalenceValue", "density"]
    },
    {
      "joinaggregate": [
        {"op": "max", "field": "density", "as": "maxDensity"}
      ],
      "groupby": ["ageGroup", "sex"]
    },
    {
      "calculate": "datum.density / datum.maxDensity",
      "as": "ridgeHeight"
    }
