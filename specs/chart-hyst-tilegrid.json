  "layer": [
    {
      "data": {
        "name": "tiles"
      },
      "transform": [
        {
          "calculate": "datum.col * 105",
          "as": "x0"
        },
        {
          "calculate": "datum.row * 105",
          "as": "y0"
        },
        {
          "calculate": "datum.x0 + 99",
          "as": "x1"
        },
        {
          "calculate": "datum.y0 + 99",
          "as": "y1"
        }
      ],
      "mark": {
        "type": "rect",
        "cornerRadius": 4,
        "stroke": "#ffffff",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              420
            ],
            "nice": false
          },
          "axis": null
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [
              420,
              0
            ],
            "nice": false
          },
          "axis": null
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "rate2021_22",
          "type": "quantitative",
          "scale": {
            "domain": [
              160,
              290
            ],
            "range": [
              "#e4f0ef",
              "#7fb8bd"
            ]
          },
          "legend": {
            "title": "2021–22 rate",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 160,
            "values": [
              160,
              200,
              240,
              280
            ]
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "rate2021_22",
            "title": "2021–22 rate per 100,000"
          }
        ]
      }
    },
    {
      "data": {
        "name": "series"
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "name": "tiles"
            },
            "key": "state",
            "fields": [
              "col",
              "row"
            ]
          }
        },
        {
          "calculate": "indexof([\"2014–15\", \"2015–16\", \"2016–17\", \"2017–18\", \"2018–19\", \"2019–20\", \"2020–21\", \"2021–22\"], datum.year)",
          "as": "i"
        },
        {
          "calculate": "datum.col * 105 + 10 + datum.i * (79 / 7)",
          "as": "tx"
        },
        {
          "calculate": "datum.row * 105 + 90 - (datum.rate - 150) / 280 * 46",
          "as": "ty"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#18313b",
        "strokeWidth": 1.6,
        "interpolate": "linear"
      },
      "encoding": {
        "x": {
          "field": "tx",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              420
            ],
            "nice": false
          }
        },
        "y": {
          "field": "ty",
          "type": "quantitative",
          "scale": {
            "domain": [
              420,
              0
            ],
            "nice": false
          }
        },
        "detail": {
          "field": "state",
          "type": "nominal"
        },
        "order": {
          "field": "i",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "name": "series"
      },
      "transform": [
        {
          "filter": "datum.year === '2021–22'"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "name": "tiles"
            },
            "key": "state",
            "fields": [
              "col",
              "row"
            ]
          }
        },
        {
          "calculate": "datum.col * 105 + 89",
          "as": "tx"
        },
        {
          "calculate": "datum.row * 105 + 90 - (datum.rate - 150) / 280 * 46",
          "as": "ty"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 28,
        "color": "#d88700"
      },
      "encoding": {
        "x": {
          "field": "tx",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              420
            ],
            "nice": false
          }
        },
        "y": {
          "field": "ty",
          "type": "quantitative",
          "scale": {
            "domain": [
              420,
              0
            ],
            "nice": false
          }
        }
      }
    },
    {
      "data": {
        "name": "tiles"
      },
      "transform": [
        {
          "calculate": "datum.col * 105 + 8",
          "as": "tx"
        },
        {
          "calculate": "datum.row * 105 + 17",
          "as": "ty"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontWeight": "bold",
        "fontSize": 13,
        "color": "#18313b"
      },
      "encoding": {
        "x": {
          "field": "tx",
